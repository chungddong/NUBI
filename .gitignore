# ── 버전관리 방침 ───────────────────────────────────────────────
# **소스와 문서만 담는다.** 형상 · 메시 파일은 스크립트로 다시 만들 수 있다.
# 예외: hoverboard_mount 의 제작용 산출물 (STEP/STL/DXF/도면) 은 발주에 그대로 쓰는 확정본이라 남긴다,
#       차량은 마지막 검증 버전 STEP 하나 (아래) 와 휠 모터 참조 STEP 하나.

# 파이썬
__pycache__/
*.py[cod]
.venv/

# FEA 외부 툴 바이너리 (460MB) — 설치는 models/hoverboard_mount/FEA.md
tools/fea/calculix/
tools/fea/calculix_*.zip
tools/fea/gmsh_pyenv/
tools/fea/python/

# 생성 형상 — models/*.py 를 실행하면 다시 나온다
exports/

# 남의 참조 STEP — 출처가 따로 있고 우리가 만든 게 아니다.
# 예외: 차량 (models/vehicle · hoverboard_mount) 을 짓는 데 꼭 필요한 호버보드 휠 모터 STEP (1MB) 하나만 담는다.
refmodel/*
!refmodel/Motor, BLDC, Hoverboard Wheel, 6.5in.stp

# FEA 중간 파일 — 케이스당 수십 MB. summary.txt / *.png / *.md 는 남긴다
models/hoverboard_mount/output/fea/**/*.inp
models/hoverboard_mount/output/fea/**/*.frd
models/hoverboard_mount/output/fea/**/*.vtu
models/hoverboard_mount/output/fea/**/*.dat
models/hoverboard_mount/output/fea/**/*.sta
models/hoverboard_mount/output/fea/**/*.cvg
models/hoverboard_mount/output/fea/**/*.12d
models/hoverboard_mount/output/fea/**/*.msh

# 로그 (뷰어 · 기록 워커 · 빌드 로그) — 실행할 때마다 새로 생긴다
*.log
*.tmp
*.bak

# 개인 설정 (권한 허용 목록 등)
.claude/settings.local.json

# 차량 시뮬레이터 데이터 (web_export.py 가 다시 만든다)
models/vehicle/sim/web/data/
# 복도 맵 — 다른 프로젝트 (D:\Develop\ClaudeGame\hallway-3d) 에서 import_hallway.py 로 복사해 온 것
models/vehicle/sim/web/hallway/

# 차량 버전 산출물 (600MB) — `record.py <버전> --rebuild` 로 다시 만든다.
#   scene.npz = 메시 캐시 (버전당 2~200MB), <버전>.step = 조립 STEP (버전당 5~50MB)
#   scene.json (수치 · 검증 기록) · images · DXF · BOM 은 기록이라 담는다.
# 예외: 마지막으로 검증까지 끝낸 버전의 STEP 하나는 공유용으로 담는다 (지금 v28_wiring, 20MB).
models/vehicle/*/output/scene.npz
models/vehicle/*/output/*.step
!models/vehicle/v28_wiring/output/v28_wiring.step

* text=auto

# 리눅스 보드(Jetson, RDK)에서 실행하는 파일은 LF로 고정
*.sh    text eol=lf
*.py    text eol=lf

# 윈도우 스크립트
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# 바이너리
*.FCStd binary
*.stl   binary
*.3mf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.pdf   binary
*.bin   binary

# 텍스트지만 diff가 의미 없는 것
*.step  -diff
*.stp   -diff

# DXF는 CAD 도구가 CRLF로 쓰므로 줄바꿈을 건드리지 않는다
*.dxf   -text

# 원본 줄바꿈이 섞여 있다(CR CR LF). 파이썬은 CR 하나도 줄바꿈으로 읽으므로 바이트를 그대로 둔다
hardware/vehicle/tools/figures/tipping_moment.py -text
